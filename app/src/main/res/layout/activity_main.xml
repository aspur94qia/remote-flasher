<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FF0B0E1A" android:padding="16dp">

    <!-- UNIVERSAL HEADER - NO MODEL -->
    <TextView
        android:id="@+id/statusDevice"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="THIS DEVICE IS ROOT MODE"
        android:textColor="#FF8AFF5A" android:textSize="14sp"
        android:textStyle="bold" android:gravity="center"
        android:padding="12dp" android:background="@drawable/bg_card_blue"
        android:layout_marginBottom="16dp"/>

    <LinearLayout android:id="@+id/btnThis"
        android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_card_blue" android:padding="16dp" android:layout_marginBottom="12dp">
        <TextView android:layout_width="40dp" android:layout_height="40dp"
            android:text="🛡" android:textSize="28sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="THIS DEVICE" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/btnOther"
        android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_card_orange" android:padding="16dp" android:layout_marginBottom="16dp">
        <TextView android:layout_width="40dp" android:layout_height="40dp"
            android:text="🔌" android:textSize="28sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="OTHER DEVICE OTG" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="LOG:" android:textColor="#FF8AFF5A" android:textSize="12sp" android:textStyle="bold"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="#FF13182B" android:layout_marginTop="4dp">
        <TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ready" android:textColor="#FF00FF88" android:textSize="11sp" android:fontFamily="monospace" android:padding="8dp"/>
    </ScrollView>
</LinearLayout>

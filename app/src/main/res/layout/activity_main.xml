<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0E1A"
    android:padding="16dp">

    <TextView android:id="@+id/statusDevice"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Model: ..." android:textColor="#FFFFFFFF" android:textSize="12sp"/>

    <LinearLayout android:id="@+id/btnThis"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:background="@drawable/bg_card_blue"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="16dp" android:padding="12dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_shield_plus"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="THIS DEVICE" android:textColor="#FFFFFFFF"
            android:textStyle="bold" android:layout_marginStart="12dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/btnOther"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:background="@drawable/bg_card_orange"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="12dp" android:padding="12dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_usb"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="OTHER DEVICE OTG" android:textColor="#FFFFFFFF"
            android:textStyle="bold" android:layout_marginStart="12dp"/>
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_warning"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp">
        <TextView android:id="@+id/logView"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF00FF88" android:fontFamily="monospace"
            android:text="LOG:"/>
    </ScrollView>
</LinearLayout>

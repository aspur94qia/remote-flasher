<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="vertical" android:background="@drawable/bg_dialog_orange" android:padding="14dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:layout_width="24dp" android:layout_height="24dp" android:text="🔌" android:gravity="center" android:background="#FF2A1A0F" android:textSize="12sp"/>
   <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="OTHER DEVICE OTG" android:textColor="#FFF59E0B" android:textStyle="bold" android:textSize="14sp" android:fontFamily="monospace" android:layout_marginStart="8dp"/>
   <TextView android:id="@+id/btnCloseOther" android:layout_width="26dp" android:layout_height="26dp" android:text="X" android:gravity="center" android:background="#FF2A1A1A" android:textColor="#FFFFFFFF"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#FF0F1424" android:padding="8dp" android:layout_marginTop="12dp" android:gravity="center_vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status Fastboot:" android:textColor="#FF8892B0" android:textSize="10sp" android:fontFamily="monospace"/>
   <TextView android:id="@+id/txtFastbootConnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="● Disconnected" android:textColor="#FFEF4444" android:textSize="10sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginStart="8dp"/>
   <TextView android:id="@+id/btnCheckFastboot" android:layout_width="48dp" android:layout_height="26dp" android:text="Cek" android:gravity="center" android:background="#FFF59E0B" android:textColor="#FF000000" android:textSize="10sp" android:fontFamily="monospace"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
   <TextView android:layout_width="22dp" android:layout_height="22dp" android:text="💾" android:gravity="center" android:background="#FFF59E0B" android:textColor="#FF000000" android:textSize="11sp"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FLASH VIA FASTBOOT OTG" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginStart="8dp"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pilih file firmware" android:textColor="#FFCCCCCC" android:textSize="11sp" android:layout_marginTop="10dp" android:fontFamily="monospace"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
   <TextView android:id="@+id/btnPilihFileOtg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:text="otg_image.img" android:gravity="center_vertical" android:paddingStart="12dp" android:background="#FF0B0F1E" android:textColor="#FFFFFFFF" android:textSize="11sp" android:fontFamily="monospace"/>
   <TextView android:layout_width="72dp" android:layout_height="38dp" android:text="Browse..." android:gravity="center" android:background="#FF1E293B" android:textColor="#FFFFFFFF" android:textSize="11sp" android:layout_marginStart="6dp" android:fontFamily="monospace"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Partisi target" android:textColor="#FFCCCCCC" android:textSize="11sp" android:layout_marginTop="10dp" android:fontFamily="monospace"/>
 <Spinner android:id="@+id/spinPartisiOtg" android:layout_width="match_parent" android:layout_height="38dp" android:background="#FF0B0F1E" android:layout_marginTop="4dp"/>
 <TextView android:id="@+id/btnMulaiFlashOtg" android:layout_width="match_parent" android:layout_height="44dp" android:text="⚡ Flash OTG" android:gravity="center" android:background="#FFF59E0B" android:textColor="#FF000000" android:textStyle="bold" android:fontFamily="monospace" android:layout_marginTop="12dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proses:" android:textColor="#FF8892B0" android:textSize="10sp" android:fontFamily="monospace"/>
   <ProgressBar android:id="@+id/progBarOtg" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="100" android:progress="0" android:layout_marginStart="8dp"/>
   <TextView android:id="@+id/txtPercentOtg" android:layout_width="38dp" android:layout_height="wrap_content" android:text="0%" android:textColor="#FFFFFFFF" android:textSize="10sp" android:fontFamily="monospace" android:gravity="center"/>
   <TextView android:id="@+id/btnCancelOtg" android:layout_width="44dp" android:layout_height="26dp" android:text="Batal" android:gravity="center" android:background="#FF1E293B" android:textColor="#FFFFFFFF" android:textSize="9sp" android:layout_marginStart="6dp" android:fontFamily="monospace"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠️ Device lain harus dalam mode fastboot + OTG terhubung" android:textColor="#FFEF4444" android:textSize="8sp" android:layout_marginTop="10dp" android:fontFamily="monospace"/>
</LinearLayout>

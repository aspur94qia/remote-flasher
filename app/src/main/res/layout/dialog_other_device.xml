<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="vertical" android:background="@drawable/bg_dialog_neon"
 android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🔌 OTHER DEVICE OTG" android:textColor="#FFF59E0B" android:textStyle="bold" android:textSize="13sp"/>
   <TextView android:id="@+id/btnCloseOther" android:layout_width="28dp" android:layout_height="28dp" android:text="X" android:gravity="center" android:background="#FF1E293B" android:textColor="white"/>
 </LinearLayout>

 <!-- STATUS CONNECT FASTBOOT - INI YANG KETINGGALAN -->
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="#FF1A2332" android:padding="8dp" android:layout_marginTop="10dp">
   <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Status:" android:textColor="#FF8892B0" android:textSize="11sp"/>
   <TextView android:id="@+id/txtFastbootConnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Disconnected" android:textColor="#FFEF4444" android:textSize="11sp" android:textStyle="bold"/>
   <TextView android:id="@+id/btnCheckFastboot" android:layout_width="60dp" android:layout_height="28dp" android:text="Cek" android:gravity="center" android:background="@drawable/bg_btn_orange" android:textColor="white" android:textSize="10sp" android:layout_marginStart="8dp"/>
 </LinearLayout>

 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FLASH VIA FASTBOOT OTG" android:textColor="#FFF59E0B" android:textSize="10sp" android:layout_marginTop="12dp" android:drawableStart="@android:drawable/ic_media_play"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="File Firmware (img/zip)" android:textColor="#FF8892B0" android:textSize="10sp" android:layout_marginTop="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
   <TextView android:id="@+id/btnPilihFileOtg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="otg_image.img" android:gravity="center_vertical" android:paddingStart="10dp" android:background="#FF0F1424" android:textColor="white" android:textSize="11sp"/>
   <TextView android:layout_width="70dp" android:layout_height="40dp" android:text="Browse..." android:gravity="center" android:background="@drawable/bg_btn_dark" android:textColor="white" android:layout_marginStart="6dp"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Partisi target" android:textColor="#FF8892B0" android:textSize="10sp" android:layout_marginTop="8dp"/>
 <Spinner android:id="@+id/spinPartisiOtg" android:layout_width="match_parent" android:layout_height="40dp" android:background="#FF0F1424" android:layout_marginTop="4dp"/>
 <TextView android:id="@+id/btnMulaiFlashOtg" android:layout_width="match_parent" android:layout_height="44dp" android:text="⚡ Flash OTG" android:gravity="center" android:background="@drawable/bg_btn_orange" android:textColor="white" android:textStyle="bold" android:layout_marginTop="12dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proses:" android:textColor="#FF8892B0" android:textSize="10sp"/>
   <ProgressBar android:id="@+id/progBarOtg" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="100" android:progress="0" android:layout_marginStart="6dp"/>
   <TextView android:id="@+id/txtPercentOtg" android:layout_width="40dp" android:layout_height="wrap_content" android:text="0%" android:textColor="white" android:textSize="10sp" android:gravity="center"/>
   <TextView android:id="@+id/btnCancelOtg" android:layout_width="40dp" android:layout_height="28dp" android:text="Batal" android:gravity="center" android:background="#FF334155" android:textColor="white" android:textSize="9sp" android:layout_marginStart="6dp"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠️ Pastikan OTG + Fastboot driver terpasang" android:textColor="#FFEF4444" android:textSize="8sp" android:layout_marginTop="8dp"/>
</LinearLayout>
